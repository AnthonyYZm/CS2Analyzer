{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roundlens.app/schemas/ipc-1.json",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "default": 1,
          "title": "Protocol Version",
          "type": "integer"
        },
        "id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "method": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "id",
        "method"
      ],
      "title": "RpcRequest",
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "RpcError",
      "type": "object"
    }
  ]
}
