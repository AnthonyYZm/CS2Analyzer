{
  "$defs": {
    "DimensionSummary": {
      "additionalProperties": false,
      "properties": {
        "grade": {
          "enum": [
            "S",
            "A",
            "B",
            "C",
            "D",
            "InsufficientData"
          ],
          "title": "Grade",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "main_positive": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Main Positive"
        },
        "main_negative": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Main Negative"
        },
        "metric_refs": {
          "items": {
            "type": "string"
          },
          "title": "Metric Refs",
          "type": "array"
        }
      },
      "required": [
        "grade",
        "status",
        "metric_refs"
      ],
      "title": "DimensionSummary",
      "type": "object"
    },
    "PriorityIssue": {
      "additionalProperties": false,
      "properties": {
        "issue_id": {
          "title": "Issue Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "severity": {
          "title": "Severity",
          "type": "string"
        },
        "priority_rank": {
          "title": "Priority Rank",
          "type": "integer"
        },
        "impact_score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Impact Score",
          "type": "integer"
        },
        "evidence_summary": {
          "title": "Evidence Summary",
          "type": "string"
        },
        "why_it_matters": {
          "title": "Why It Matters",
          "type": "string"
        },
        "main_contexts": {
          "items": {
            "type": "string"
          },
          "title": "Main Contexts",
          "type": "array"
        },
        "trend": {
          "title": "Trend",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "metric_refs": {
          "items": {
            "type": "string"
          },
          "title": "Metric Refs",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "review_round_ids": {
          "items": {
            "type": "string"
          },
          "title": "Review Round Ids",
          "type": "array"
        },
        "next_match_rule": {
          "title": "Next Match Rule",
          "type": "string"
        },
        "target_metric": {
          "title": "Target Metric",
          "type": "string"
        }
      },
      "required": [
        "issue_id",
        "title",
        "category",
        "severity",
        "priority_rank",
        "impact_score",
        "evidence_summary",
        "why_it_matters",
        "main_contexts",
        "trend",
        "confidence",
        "metric_refs",
        "evidence_refs",
        "review_round_ids",
        "next_match_rule",
        "target_metric"
      ],
      "title": "PriorityIssue",
      "type": "object"
    },
    "ReportReviewRound": {
      "additionalProperties": false,
      "properties": {
        "round_id": {
          "title": "Round Id",
          "type": "string"
        },
        "review_type": {
          "title": "Review Type",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "why_review": {
          "title": "Why Review",
          "type": "string"
        },
        "issue_tags": {
          "items": {
            "type": "string"
          },
          "title": "Issue Tags",
          "type": "array"
        },
        "key_event_summary": {
          "title": "Key Event Summary",
          "type": "string"
        },
        "review_questions": {
          "items": {
            "type": "string"
          },
          "title": "Review Questions",
          "type": "array"
        },
        "recommended_action": {
          "title": "Recommended Action",
          "type": "string"
        },
        "positive_contrast": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Positive Contrast"
        }
      },
      "required": [
        "round_id",
        "review_type",
        "title",
        "why_review",
        "issue_tags",
        "key_event_summary",
        "review_questions",
        "recommended_action"
      ],
      "title": "ReportReviewRound",
      "type": "object"
    },
    "ReportStrength": {
      "additionalProperties": false,
      "properties": {
        "strength_id": {
          "title": "Strength Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "evidence_summary": {
          "title": "Evidence Summary",
          "type": "string"
        },
        "value_to_winning": {
          "title": "Value To Winning",
          "type": "string"
        },
        "applicable_contexts": {
          "items": {
            "type": "string"
          },
          "title": "Applicable Contexts",
          "type": "array"
        },
        "trend": {
          "title": "Trend",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "positive_round_ids": {
          "items": {
            "type": "string"
          },
          "title": "Positive Round Ids",
          "type": "array"
        },
        "maintain_rule": {
          "title": "Maintain Rule",
          "type": "string"
        }
      },
      "required": [
        "strength_id",
        "title",
        "category",
        "evidence_summary",
        "value_to_winning",
        "applicable_contexts",
        "trend",
        "confidence",
        "positive_round_ids",
        "maintain_rule"
      ],
      "title": "ReportStrength",
      "type": "object"
    },
    "ReportSummary": {
      "additionalProperties": false,
      "properties": {
        "overall_status": {
          "title": "Overall Status",
          "type": "string"
        },
        "one_sentence_summary": {
          "title": "One Sentence Summary",
          "type": "string"
        },
        "matches_analyzed": {
          "title": "Matches Analyzed",
          "type": "integer"
        },
        "rounds_analyzed": {
          "title": "Rounds Analyzed",
          "type": "integer"
        },
        "data_confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Data Confidence",
          "type": "number"
        },
        "analysis_scope": {
          "enum": [
            "single_match",
            "multi_match"
          ],
          "title": "Analysis Scope",
          "type": "string"
        }
      },
      "required": [
        "overall_status",
        "one_sentence_summary",
        "matches_analyzed",
        "rounds_analyzed",
        "data_confidence",
        "analysis_scope"
      ],
      "title": "ReportSummary",
      "type": "object"
    },
    "TrainingGoal": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "title": "Title",
          "type": "string"
        },
        "metric_id": {
          "title": "Metric Id",
          "type": "string"
        },
        "current_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Current Value"
        },
        "target_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target Value"
        },
        "behavior_rule": {
          "title": "Behavior Rule",
          "type": "string"
        }
      },
      "required": [
        "title",
        "metric_id",
        "current_value",
        "target_value",
        "behavior_rule"
      ],
      "title": "TrainingGoal",
      "type": "object"
    },
    "TrainingPlan": {
      "additionalProperties": false,
      "properties": {
        "period": {
          "title": "Period",
          "type": "string"
        },
        "primary_goals": {
          "items": {
            "$ref": "#/$defs/TrainingGoal"
          },
          "maxItems": 2,
          "title": "Primary Goals",
          "type": "array"
        },
        "maintenance_goals": {
          "items": {
            "$ref": "#/$defs/TrainingGoal"
          },
          "maxItems": 1,
          "title": "Maintenance Goals",
          "type": "array"
        }
      },
      "required": [
        "period",
        "primary_goals",
        "maintenance_goals"
      ],
      "title": "TrainingPlan",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "report_summary": {
      "$ref": "#/$defs/ReportSummary"
    },
    "priority_issues": {
      "items": {
        "$ref": "#/$defs/PriorityIssue"
      },
      "maxItems": 5,
      "title": "Priority Issues",
      "type": "array"
    },
    "review_rounds": {
      "items": {
        "$ref": "#/$defs/ReportReviewRound"
      },
      "maxItems": 8,
      "title": "Review Rounds",
      "type": "array"
    },
    "strengths": {
      "items": {
        "$ref": "#/$defs/ReportStrength"
      },
      "maxItems": 4,
      "title": "Strengths",
      "type": "array"
    },
    "dimension_summaries": {
      "additionalProperties": {
        "$ref": "#/$defs/DimensionSummary"
      },
      "title": "Dimension Summaries",
      "type": "object"
    },
    "training_plan": {
      "$ref": "#/$defs/TrainingPlan"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "report_summary",
    "priority_issues",
    "review_rounds",
    "strengths",
    "dimension_summaries",
    "training_plan",
    "warnings"
  ],
  "title": "CoachingReport",
  "type": "object",
  "$id": "https://roundlens.app/schemas/report-1.0.0.json"
}
